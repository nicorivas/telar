#!/bin/bash
# Deja a un colega con su propio entorno de telar en este servidor: su usuario, aislado de
# los agentes, con tope de recursos y con telar y Claude Code instalados en SU home.
#
# Uso (como root, porque toca el usuario y systemd):
#   sudo bash alta-colega USUARIO [MEMORIA_MAX] [CPU_PORCIENTO]
#   sudo bash alta-colega marcelo 2500M 100%
#
# El usuario debe existir ya (useradd) y tener su llave en ~/.ssh/authorized_keys.
# Es idempotente: se puede volver a correr. Lo que NO hace, a propósito:
#   - abrir el puerto 22 en Tailscale (eso lo decide la persona dueña del servidor);
#   - iniciar sesión en Claude: cada colega corre `claude login` con SU cuenta.
set -euo pipefail

U="${1:?uso: alta-colega USUARIO [MEMORIA_MAX] [CPU_PORCIENTO]}"
MEM="${2:-2500M}"
CPU="${3:-100%}"

[ "$(id -u)" = 0 ] || { echo "corre esto con sudo" >&2; exit 1; }
id "$U" >/dev/null || { echo "el usuario $U no existe" >&2; exit 1; }
UID_=$(id -u "$U")

echo "== 1. fuera del grupo «agentes» (da lectura al correo archivado de la máquina)"
if id -nG "$U" | tr ' ' '\n' | grep -qx agentes; then gpasswd -d "$U" agentes; else echo "ya no está"; fi

echo "== 2. tope de recursos de su rebanada de systemd"
d="/etc/systemd/system/user-${UID_}.slice.d"
install -d "$d"
cat > "$d/50-telar-colega.conf" <<EOF
# alta-colega: lo que un colega puede usar de esta máquina, que además corre los agentes.
[Slice]
MemoryHigh=${MEM}
MemoryMax=${MEM}
CPUQuota=${CPU}
TasksMax=400
EOF
systemctl daemon-reload
# Que su tmux sobreviva a cerrar la sesión ssh, y que el tope valga también entonces.
loginctl enable-linger "$U"

echo "== 3. su telar y su Claude Code, en su home (no usan nada tuyo)"
sudo -iu "$U" bash -s <<'EOS'
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
command -v uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh | sh
command -v claude >/dev/null || curl -fsSL https://claude.ai/install.sh | bash
uv tool install --force "git+https://github.com/nicorivas/telar"
grep -q '.local/bin' "$HOME/.profile" 2>/dev/null || echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.profile"
telar agente instalar --si
EOS

echo
echo "Listo. Faltan, de su parte: «claude login» con su cuenta."
echo "Y de la tuya: la regla tcp:22 para su nodo en la política de Tailscale."

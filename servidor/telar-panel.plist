<?xml version="1.0" encoding="UTF-8"?>
<!-- telar panel en macOS (launchd): la barra, el dashboard y las terminales en http://127.0.0.1:8770.
     Reemplaza TU_USUARIO, y que `node` esté en alguna carpeta del PATH de abajo.
     cp telar-panel.plist ~/Library/LaunchAgents/com.telar.panel.plist
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.telar.panel.plist
     La dirección con la llave, la primera vez: grep k= ~/Library/Logs/telar-panel.log | tail -1
     Ver cómo va: tail -f ~/Library/Logs/telar-panel.log
     Quitarlo:    launchctl bootout gui/$(id -u)/com.telar.panel -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.telar.panel</string>
  <key>ProgramArguments</key>
  <array><string>/Users/TU_USUARIO/.local/bin/telar</string><string>panel</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/TU_USUARIO/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/TU_USUARIO/Library/Logs/telar-panel.log</string>
  <key>StandardErrorPath</key><string>/Users/TU_USUARIO/Library/Logs/telar-panel.log</string>
</dict>
</plist>

#!/bin/sh
# telar-puerta-instalar: instala la puerta del servidor (telar.puerta). Como root, una vez (y otra para actualizarla).
#
#   sudo servidor/telar-puerta-instalar --dueno nico --cuenta nicorivas@gmail.com [--version 0.7.0] [--url https://…]
#                                       [--desde telar-X.whl]   (de un paquete local, para probar una sin publicar)
#
# Qué hace:
#   - el usuario y grupo de sistema telar-puerta (sin casa, sin shell)
#   - telar en /opt/telar-puerta (un venv propio, de PyPI: no depende de la casa de nadie)
#   - /etc/telar/puerta.toml: la dirección de la puerta y la cuenta de Tailscale de quien administra (si no estaba)
#   - las carpetas de los sockets en /run/telar (tmpfiles): la de la puerta, y la de quien administra
#   - el servicio telar-puerta, arrancado
# Lo que no hace (lo dice al final): poner la puerta en la dirección del servidor (`tailscale serve`) ni agregar
# --web-socket al servicio de quien administra. Los alojados nuevos ya nacen detrás de la puerta (telar-alojar).
set -eu

DUENO="" CUENTA="" VERSION="" URL="" DESDE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dueno) DUENO="$2"; shift 2 ;;
    --cuenta) CUENTA="$2"; shift 2 ;;
    --version) VERSION="$2"; shift 2 ;;
    --url) URL="$2"; shift 2 ;;
    --desde) DESDE="$2"; shift 2 ;;
    *) echo "no entiendo «$1»" >&2; exit 2 ;;
  esac
done
[ "$(id -u)" = 0 ] || { echo "como root: sudo $0 …" >&2; exit 2; }
echo "$DUENO" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$' || { echo "--dueno: el usuario de quien administra" >&2; exit 2; }
id "$DUENO" >/dev/null 2>&1 || { echo "--dueno: no hay un usuario «$DUENO»" >&2; exit 2; }
echo "$CUENTA" | grep -Eq '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$' || { echo "--cuenta: su cuenta de Tailscale (tailscale whois)" >&2; exit 2; }
if [ -z "$URL" ]; then
  NOMBRE=$(tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))')
  URL="https://$NOMBRE"
fi
echo "$URL" | grep -Eq '^https://[A-Za-z0-9.-]+(:[0-9]{2,5})?$' || { echo "--url: https://…" >&2; exit 2; }

echo "== el usuario telar-puerta"
getent group telar-puerta >/dev/null || groupadd --system telar-puerta
id telar-puerta >/dev/null 2>&1 || useradd --system -g telar-puerta -d /nonexistent -s /usr/sbin/nologin -c "telar puerta" telar-puerta

echo "== telar en /opt/telar-puerta"
[ -x /opt/telar-puerta/bin/python ] || python3 -m venv /opt/telar-puerta
/opt/telar-puerta/bin/pip install --quiet --upgrade pip
if [ -n "$DESDE" ]; then
  /opt/telar-puerta/bin/pip install --quiet --upgrade --force-reinstall "$DESDE[serve]"
else
  # recién publicada, el índice de PyPI tarda un poco en verla (y pip guarda el de antes): sin caché, y unos intentos
  for i in 1 2 3 4 5 6; do
    PIP_NO_CACHE_DIR=1 /opt/telar-puerta/bin/pip install --quiet --upgrade "telar[serve]${VERSION:+==$VERSION}" && break
    [ "$i" = 6 ] && exit 1
    echo "   todavía no está en PyPI: reintento en 10 s"; sleep 10
  done
fi
/opt/telar-puerta/bin/telar --version

echo "== /etc/telar/puerta.toml"
mkdir -p /etc/telar/alojados.d
if [ ! -e /etc/telar/puerta.toml ]; then
  cat > /etc/telar/puerta.toml <<FIN
# La puerta del servidor (telar.puerta): su dirección, y quién entra además de los alojados
# (los alojados están en /etc/telar/alojados.d/, con su cuenta de Tailscale).
url = "$URL"
# a su telar van los pedidos para entrar de quien todavía no tiene lugar (/unirse)
dueno = "$DUENO"

[personas]
# cuenta de Tailscale = usuario del servidor
"$CUENTA" = "$DUENO"
FIN
  chmod 644 /etc/telar/puerta.toml
else
  echo "   ya estaba: no la toco"
fi

echo "== las carpetas de los sockets (/run/telar)"
cat > /etc/tmpfiles.d/telar-puerta.conf <<FIN
d /run/telar 0755 root root -
d /run/telar/puerta 0700 telar-puerta telar-puerta -
d /run/telar/$DUENO 2750 $DUENO telar-puerta -
FIN
systemd-tmpfiles --create /etc/tmpfiles.d/telar-puerta.conf

echo "== el servicio"
DIR=$(dirname "$0")
install -m 644 "$DIR/telar-puerta.service" /etc/systemd/system/telar-puerta.service
systemctl daemon-reload
systemctl enable --quiet telar-puerta
systemctl restart telar-puerta
sleep 2
systemctl is-active telar-puerta

cat <<FIN

Lista. Falta:
  1. que el telar de $DUENO también escuche para la puerta: --web-socket /run/telar/$DUENO/web.sock en su servicio
     (como $DUENO: telar instalar --web-socket /run/telar/$DUENO/web.sock --si), y reiniciarlo
  2. ponerla en la dirección del servidor:
       tailscale serve --bg --https=443 unix:/run/telar/puerta/puerta.sock
  3. probarla: $URL
FIN

{
  "name": "telar-pagina",
  "private": true,
  "description": "La página de telar (telar serve --web): la barra de hilos, el dashboard y cada hilo, empaquetados en src/telar/web/. Antes, la extensión de VS Code, deprecada el 20-oct-2026.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicorivas/telar.git",
    "directory": "vscode"
  },
  "scripts": {
    "tipos": "tsc -p tsconfig.navegador.json && tsc -p . --noEmit",
    "navegador": "tsc -p tsconfig.navegador.json && node scripts/navegador.mjs --min",
    "navegador:watch": "node scripts/navegador.mjs --watch --min",
    "lint:css": "stylelint \"media/css/*.css\"",
    "prueba:eco": "node pruebas/eco.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.12",
    "markdown-it": "^15.0.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.5.0"
  }
}
